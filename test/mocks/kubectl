#!/bin/bash
# Mock kubectl for testing
# Behavior can be controlled via environment variables

# Log all calls for debugging
if [[ -n "${KUBECTL_SPY_FILE:-}" ]]; then
  echo "$@" >> "$KUBECTL_SPY_FILE"
fi

# Check for specific mock behaviors
case "${KUBECTL_MOCK_MODE:-success}" in
  fail)
    echo "Error: mocked kubectl failure" >&2
    exit 1
    ;;
  timeout)
    sleep 300
    exit 1
    ;;
  custom)
    if [[ -n "${KUBECTL_MOCK_OUTPUT:-}" ]]; then
      echo "$KUBECTL_MOCK_OUTPUT"
    fi
    exit "${KUBECTL_MOCK_EXIT_CODE:-0}"
    ;;
  *)
    # Default success mode - return appropriate output based on command
    case "$1" in
      version)
        echo "Client Version: v1.28.0"
        ;;
      get)
        case "$2" in
          pods)
            if [[ "$*" == *"-o jsonpath"* ]]; then
              # Return pod list
              echo "test-pod-1 test-pod-2"
            else
              # Return pod details
              cat <<EOF
NAME          READY   STATUS    RESTARTS   AGE
test-pod-1    1/1     Running   0          1h
test-pod-2    1/1     Running   0          1h
EOF
            fi
            ;;
          nodes)
            if [[ "$*" == *"-o jsonpath"* ]]; then
              echo "node-1 node-2"
            else
              cat <<EOF
NAME     STATUS   ROLES    AGE   VERSION
node-1   Ready    master   1d    v1.28.0
node-2   Ready    worker   1d    v1.28.0
EOF
            fi
            ;;
          pod)
            if [[ "$*" == *"jsonpath='{.spec.nodeName}'"* ]]; then
              echo "test-node"
            elif [[ "$*" == *"jsonpath='{.spec.containers[*].name}'"* ]]; then
              echo "debugger file-monitor"
            elif [[ "$*" == *"jsonpath='{.status.phase}'"* ]]; then
              echo "Running"
            fi
            ;;
          --raw)
            # Mock kubelet configz endpoint
            if [[ "$*" == *"/configz"* ]]; then
              echo '{"kubeletconfig":{"evictionHard":{"imagefs.available":"15%","memory.available":"100Mi","nodefs.available":"10%","nodefs.inodesFree":"5%"}}}'
            fi
            ;;
        esac
        ;;
      apply)
        echo "pod/test-debug-pod created"
        ;;
      delete)
        echo "pod \"test-debug-pod\" deleted"
        ;;
      exec)
        # Simulate successful exec
        echo "exec output"
        ;;
      logs)
        echo "pod logs output"
        ;;
      wait)
        # Simulate wait success
        ;;
      *)
        # Unknown command
        echo "Unknown command: $*" >&2
        exit 1
        ;;
    esac
    exit 0
    ;;
esac
